{
  "name": "game-hub",
  "version": "0.4.2",
  "private": true,
  "description": "离线四项目 Android 游戏大厅",
  "license": "MIT",
  "author": "xiaoxuhui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxuhui/game-hub.git"
  },
  "homepage": "https://github.com/xiaoxuhui/game-hub#readme",
  "bugs": "https://github.com/xiaoxuhui/game-hub/issues",
  "keywords": [
    "android",
    "offline",
    "game-hub",
    "webview"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test": "node scripts/test-core.mjs",
    "check": "node --check scripts/bundle.mjs && node scripts/test-core.mjs",
    "bundle": "node scripts/bundle.mjs",
    "verify:bundle": "node scripts/bundle.mjs --verify",
    "audit:storage": "node scripts/audit-storage.mjs",
    "bundle:resources": "node scripts/resource-bundle.mjs",
    "prepare:resources": "node scripts/resource-sources.mjs",
    "verify:resources": "node scripts/resource-bundle.mjs --verify",
    "prepare:dynamic": "node scripts/dynamic-resources.mjs",
    "verify:dynamic": "node scripts/dynamic-resources.mjs --verify",
    "check:web": "node scripts/web/check.mjs",
    "audit:web": "node scripts/web/audit.mjs",
    "audit:web:native": "node scripts/web/audit-native.mjs",
    "test:web:browser": "playwright test --config e2e/web/playwright.config.mjs",
    "test:web": "node --test tests/web/*.test.mjs",
    "test:web:build": "node tests/web/build.integration.mjs",
    "test:web:catalog": "node tests/web/catalog.integration.mjs",
    "prepare:web": "node scripts/web/inputs.mjs",
    "build:web": "node scripts/web/build.mjs",
    "verify:web": "node scripts/web/build.mjs --verify",
    "serve:web": "node scripts/web/serve.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "@playwright/test": "1.62.1",
    "typescript": "5.9.3"
  }
}
